{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Caesar",
  "description": "Documentation for Caesar, the all-in-one Discord bot for security, moderation, economy and community features.",
  "colors": {
    "primary": "#315F9A",
    "light": "#6F9FD8",
    "dark": "#15335B"
  },
  "favicon": "favicon.png",
  "logo": "favicon.png",
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "icon": "compass",
        "pages": ["overview/introduction"]
      },
      {
        "group": "Security and Moderation",
        "icon": "shield-halved",
        "pages": [
          "security/antinuke",
          "security/antiraid",
          "security/moderation"
        ]
      },
      {
        "group": "Server Features",
        "icon": "gear",
        "pages": [
          "configuration/admin",
          "configuration/roles/reaction",
          "configuration/roles/custom",
          "configuration/messages/responder",
          "configuration/tickets/overview",
          "configuration/level-rewards",
          "miscellaneous/giveaway"
        ]
      },
      {
        "group": "Economy and Community",
        "icon": "coins",
        "pages": [
          "economy/overview",
          "economy/earning",
          "economy/activities",
          "economy/items",
          "economy/organisations",
          "economy/games",
          "economy/chances",
          "community/invites",
          "community/verification",
          "community/leaderboard"
        ]
      },
      {
        "group": "Nordicalls Dashboard",
        "icon": "gauge",
        "pages": ["dashboard/overview"]
      },
      {
        "group": "Resources",
        "icon": "book",
        "pages": ["resources/syntax", "resources/permissions", "resources/tts"]
      },
      {
        "group": "Troubleshooting",
        "icon": "wrench",
        "pages": ["common-issues/permissions", "common-issues/server-removal"]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Nordicalls",
      "href": "https://discord.gg/nordicalls"
    }
  },
  "search": {
    "prompt": "Search Caesar docs..."
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true,
    "raiseIssue": true
  },
  "seo": {
    "metatags": {
      "theme-color": "#15335B",
      "og:site_name": "Nordicalls",
      "og:type": "website",
      "og:image": "https://docs.hvurs.cc/images/caesaropengraph.png?v=2",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://docs.hvurs.cc/images/caesaropengraph.png?v=2"
    },
    "indexing": "navigable"
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/nordicalls",
      "github": "https://github.com/hvurs/docs"
    }
  },
  "redirects": [
    {
      "source": "/discord",
      "destination": "https://discord.gg/nordicalls"
    }
  ]
}
