{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Caesar",
  "colors": {
    "primary": "#315F9A",
    "light": "#6F9FD8",
    "dark": "#15335B"
  },
  "favicon": "favicon.png",
  "navigation": {
    "groups": [
      {
        "group": "Overview",
        "pages": ["overview/introduction"]
      },
      {
        "group": "Security and Moderation",
        "pages": [
          "security/antinuke",
          "security/antiraid",
          "security/moderation"
        ]
      },
      {
        "group": "Server Features",
        "pages": [
          "configuration/admin",
          "configuration/roles/reaction",
          "configuration/messages/responder",
          "configuration/tickets/overview",
          "configuration/level-rewards",
          "miscellaneous/giveaway"
        ]
      },
      {
        "group": "Economy and Community",
        "pages": [
          "economy/overview",
          "economy/chances",
          "community/invites",
          "community/leaderboard"
        ]
      },
      {
        "group": "Resources",
        "pages": ["resources/syntax", "resources/permissions"]
      },
      {
        "group": "Troubleshooting",
        "pages": ["common-issues/permissions", "common-issues/server-removal"]
      }
    ]
  },
  "logo": {
    "light": "favicon.png",
    "dark": "favicon.png"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Caesar Community",
      "href": "https://discord.gg/nordicalls"
    }
  },
  "seo": {
    "metatags": {
      "theme-color": "#15335B",
      "og:site_name": "Caesar",
      "og:type": "website",
      "og:image": "https://nordicalls-ed759818.mintlify.app/images/caesar-og.png",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://nordicalls-ed759818.mintlify.app/images/caesar-og.png"
    },
    "indexing": "navigable"
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/nordicalls",
      "github": "https://github.com/hvurs/nordicalls"
    }
  },
  "redirects": [
    {
      "source": "/discord",
      "destination": "https://discord.gg/nordicalls"
    }
  ]
}
